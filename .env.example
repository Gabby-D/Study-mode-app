# Copy this file to: G:\My Drive\none_git_files\Study-mode-app\.env
# The app reads SMTP settings from that Google Drive folder (gitignored secrets).
STUDY_MODE_SMTP_USERNAME=your-gmail-address@gmail.com
STUDY_MODE_SMTP_APP_PASSWORD=your-gmail-app-password
STUDY_MODE_SMTP_SERVER=smtp.gmail.com
STUDY_MODE_SMTP_FROM=your-gmail-address@gmail.com
